{
    // 任务ID
    "taskId": "xxxxxx",

    // 引擎信息
    "engineCode": "xxxx",                    // 引擎编码
    "engineSecret": "xxxx",                  // 引擎密钥

    // 其他信息
    "timestamp": "string",                     // 时间戳
    "fileName": "string",                      // 文件名
    "base64String": "string",                  // Base64文件内容

    // case_结果列表
    "caseResultList": [
        {
            // 集合、用例ID
            "collectionId": "string",
            "caseId": "string",

            // 用例结果信息
            "status": 0,                        // 执行状态
            "caseType": "api",                  // 用例类型
            "startTime": 0,                     // 开始时间
            "endTime": 0,                       // 结束时间

            "caseName": "name",                // 用例名称
            "caseDesc": "string",              // 用例描述
            "index": 0,                        // 用例索引
            "runTimes": 0,                     // 执行次数

            // case_api结果信息
            "transactionList": [
                {
                    "id": "string",                     // api_id
                    "name": "string",                   // api_name
                    "content": "/api/login",            // api_path（请求路径）
                    "description": "string",            // case_api_desc（步骤描述）

                    "status": 0,                        // 状态码（0/1/2/3）（通过/失败/错误）
                    "log": "string",                    // 执行日志
                    "during": 0,                        // 耗时（ms）

                    // 截图列表（URL或Base64标识
                    "screenShotList": [
                        "string"
                    ]
                }
            ]
        }
    ]
}